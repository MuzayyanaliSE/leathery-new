{% liquid
  assign sid = 'lco-' | append: section.id
%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Phudu:wght@600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
  rel="stylesheet"
>
<link
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
  rel="stylesheet"
>

<style>
        #{{ sid }},
        #{{ sid }} *,
        #{{ sid }} *::before,
        #{{ sid }} *::after {
          box-sizing: border-box;
        }

        #{{ sid }} {
          --primary: #B4703E;
          --primary-deep: #6F4627;
          --primary-soft: #F4BB92;
          --ink: #1F1B18;
          --surface: #FFF8F5;
          --surface-high: #F1E6E1;
          --surface-soft: #FBF3EE;
          --line: rgba(111, 70, 39, 0.14);
          --line-strong: rgba(111, 70, 39, 0.2);
          --text-muted: #5C5048;
          --white: #ffffff;

          font-family: "Inter", system-ui, sans-serif !important;
          color: var(--ink) !important;
          background: var(--surface);
          width: 100%;
          max-width: 100%;
          overflow: hidden;
          position: relative;
          line-height: 1.5;
          -webkit-font-smoothing: antialiased;
        }

        #{{ sid }} a,
        #{{ sid }} a:hover,
        #{{ sid }} a:focus,
        #{{ sid }} a:active {
          text-decoration: none !important;
        }

        #{{ sid }} img {
          display: block;
          max-width: 100%;
          height: auto;
          border: 0;
        }

        #{{ sid }} h1,
        #{{ sid }} h2,
        #{{ sid }} h3,
        #{{ sid }} h4,
        #{{ sid }} h5,
        #{{ sid }} h6,
        #{{ sid }} p,
        #{{ sid }} ul,
        #{{ sid }} ol,
        #{{ sid }} li,
        #{{ sid }} figure,
        #{{ sid }} details,
        #{{ sid }} summary {
          margin: 0;
          padding: 0;
        }

     #{{ sid }} .material-symbols-outlined {
      font-variation-settings:
        "FILL" 0,
        "wght" 300,
        "GRAD" 0,
        "opsz" 48;
      line-height: 1;
      vertical-align: middle;
    }

        #{{ sid }} .lco-wrap {
          width: min(100% - 40px, 1280px);
          margin: 0 auto;
        }

        #{{ sid }} .lco-display {
          font-family: "Phudu", Impact, sans-serif !important;
          font-weight: 800 !important;
        }

        #{{ sid }} .lco-body {
          font-family: "Inter", system-ui, sans-serif !important;
        }

        #{{ sid }} .lco-section {
          padding: 80px 0;
        }

        #{{ sid }} .lco-divider {
          border-top: 1px solid var(--line);
        }

        #{{ sid }} .lco-artisan-panel {
          background:
            linear-gradient(180deg, rgba(244, 187, 146, 0.08) 0%, rgba(255, 248, 245, 0) 100%),
            var(--surface);
        }

        #{{ sid }} .lco-soft-rule {
          height: 1px;
          background: linear-gradient(
            90deg,
            rgba(180, 112, 62, 0) 0%,
            rgba(180, 112, 62, 0.35) 50%,
            rgba(180, 112, 62, 0) 100%
          );
        }

        #{{ sid }} .lco-industrial-button {
          box-shadow: inset 0 0 0 1px rgba(31, 27, 24, 0.08);
        }

        #{{ sid }} .lco-card {
          border: 1px solid rgba(111, 70, 39, 0.12);
        }

        #{{ sid }} .lco-eyebrow {
          display: block;
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.22em;
          text-transform: uppercase;
        }

        #{{ sid }} .lco-title {
          font-size: clamp(32px, 4.8vw, 64px) !important;
          line-height: 1.02 !important;
          letter-spacing: 0.04em !important;
          text-transform: uppercase;
        }

        #{{ sid }} .lco-subtitle {
          font-size: clamp(30px, 4.2vw, 52px) !important;
          line-height: 1.06 !important;
          letter-spacing: 0.04em !important;
          text-transform: uppercase;
        }

        #{{ sid }} .lco-hero {
          position: relative;
          min-height: 100svh;
          display: flex;
          align-items: center;
          border-bottom: 1px solid var(--line);
          overflow: hidden;
        }

        #{{ sid }} .lco-hero__media,
  #{{ sid }} .lco-hero__scrim {
    position: absolute;
    inset: 0;
  }

      #{{ sid }} .lco-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) brightness(0.45);
  }

        {% comment %} #{{ sid }} .lco-hero__overlay {
          background: rgba(31, 27, 24, 0.55);
          mix-blend-mode: multiply;
        } {% endcomment %}

        {% comment %} #{{ sid }} .lco-hero__gradient {
          background: linear-gradient(to top, var(--ink), rgba(31, 27, 24, 0.3), transparent);
        } {% endcomment %}

        #{{ sid }} .lco-hero__scrim {
  background:
    linear-gradient(
      180deg,
      rgba(31, 27, 24, 0.30) 0%,
      rgba(31, 27, 24, 0.55) 70%,
      rgba(31, 27, 24, 0.85) 100%
    ),
    radial-gradient(
      80% 60% at 20% 30%,
      rgba(180, 112, 62, 0.20) 0%,
      transparent 70%
    );
}

        #{{ sid }} .lco-hero__content {
          position: relative;
          z-index: 2;
          width: min(100% - 40px, 1280px);
          margin: 0 auto;
          padding-top: 110px;
          padding-bottom: 110px;
        }

        #{{ sid }} .lco-hero__inner {
          max-width: 960px;
          margin: 0 auto;
          text-align: center;
        }

        #{{ sid }} .lco-hero__badge {
          display: inline-block;
          border: 1px solid rgba(255, 255, 255, 0.2);
          background: rgba(255, 255, 255, 0.05);
          padding: 10px 16px;
          margin-bottom: 28px;
          font-size: 11px;
          font-weight: 600;
          text-transform: uppercase;
          letter-spacing: 0.22em;
          color: rgba(255, 255, 255, 0.9);
        }

        #{{ sid }} .lco-hero__title {
          color: #fff !important;
          margin-bottom: 20px !important;
        }

        #{{ sid }} .lco-hero__rule {
          max-width: 160px;
          margin: 0 auto 24px;
        }

        #{{ sid }} .lco-hero__text {
          color: rgba(255, 255, 255, 0.85);
          max-width: 760px;
          margin: 0 auto 40px !important;
          font-size: clamp(16px, 2vw, 24px);
          line-height: 1.75;
          font-weight: 400;
        }

        #{{ sid }} .lco-btn-row {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          gap: 16px;
        }

        #{{ sid }} .lco-btn {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-height: 56px;
          padding: 0 32px;
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.22em;
          text-transform: uppercase;
          transition: 0.25s ease;
        }

        #{{ sid }} .lco-btn--primary {
          background: var(--primary);
          color: #fff !important;
        }

        #{{ sid }} .lco-btn--primary:hover {
          background: var(--primary-deep);
        }

        #{{ sid }} .lco-btn--ghost {
          border: 1px solid rgba(255, 255, 255, 0.3);
          color: #fff !important;
          background: transparent;
        }

        #{{ sid }} .lco-btn--ghost:hover {
          background: rgba(255, 255, 255, 0.1);
        }

        #{{ sid }} .lco-trustbar {
          position: absolute;
          bottom: 0;
          left: 0;
          width: 100%;
          background: rgba(255, 255, 255, 0.08);
          backdrop-filter: blur(8px);
          border-top: 1px solid rgba(255, 255, 255, 0.1);
          padding: 18px 0;
          z-index: 3;
        }

        #{{ sid }} .lco-trustbar__inner {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          gap: 14px 28px;
          color: rgba(255, 255, 255, 0.9);
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 0.22em;
          text-transform: uppercase;
          text-align: center;
        }

        #{{ sid }} .lco-grid-3 {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        #{{ sid }} .lco-grid-3 > * + * {
          margin-left: -1px;
        }

        #{{ sid }} .lco-grid-6 {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        #{{ sid }} .lco-grid-6 > * {
          margin-top: -1px;
          margin-left: -1px;
        }

        #{{ sid }} .lco-custom-card {
          background: var(--surface);
          padding: 40px;
          transition: background 0.25s ease;
        }

        #{{ sid }} .lco-custom-card:hover {
          background: var(--surface-soft);
        }

      #{{ sid }} .lco-custom-card .material-symbols-outlined {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 56px;
      line-height: 1;
      color: var(--primary);
      margin-bottom: 24px;
    }

        #{{ sid }} .lco-custom-card h3 {
          font-size: 22px !important;
          line-height: 1.2;
          text-transform: uppercase;
          letter-spacing: 0.03em;
          color: var(--ink) !important;
          margin-bottom: 14px !important;
        }

        #{{ sid }} .lco-custom-card p {
          color: var(--text-muted);
          line-height: 1.8;
          font-size: 16px;
        }

        #{{ sid }} .lco-dark {
          background: var(--ink);
          color: var(--surface);
        }

        #{{ sid }} .lco-dark-head {
          text-align: center;
          margin-bottom: 56px;
        }

        #{{ sid }} .lco-dark-head p {
          max-width: 760px;
          margin: 24px auto 0 !important;
          color: rgba(255,255,255,0.70);
          line-height: 1.8;
          font-size: 16px;
        }

        #{{ sid }} .lco-range-grid {
          display: grid;
          grid-template-columns: repeat(5, minmax(0, 1fr));
          gap: 32px;
        }

        #{{ sid }} .lco-range-item {
          display: flex;
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        #{{ sid }} .lco-range-item .material-symbols-outlined {
    font-size: 54px !important;
    line-height: 1 !important;
    width: 54px !important;
    height: 54px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-variation-settings:
      "FILL" 0,
      "wght" 500,
      "GRAD" 0,
      "opsz" 54 !important;
  }

   #{{ sid }} .lco-range-icon {
    width: 104px;
    height: 104px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.15);
    margin-bottom: 18px;
    transition: 0.25s ease;
  }



        #{{ sid }} .lco-range-item:hover .lco-range-icon {
          background: var(--primary);
          border-color: var(--primary);
        }

      #{{ sid }} .lco-range-icon .material-symbols-outlined {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 50px;
    line-height: 1;
    font-variation-settings:
      "FILL" 0,
      "wght" 500,
      "GRAD" 0,
      "opsz" 48;
  }

       #{{ sid }} .lco-range-item span:last-child {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
        #{{ sid }} .lco-range-item.is-active .lco-range-icon {
          background: var(--primary);
          border-color: var(--primary);
        }

        #{{ sid }} .lco-process-head {
          text-align: center;
          margin-bottom: 56px;
        }

        #{{ sid }} .lco-process-line {
          position: relative;
        }

        #{{ sid }} .lco-process-line::before {
          content: "";
          position: absolute;
          top: 48px;
          left: 0;
          width: 100%;
          height: 1px;
          background: var(--line-strong);
          display: none;
        }

        #{{ sid }} .lco-process-grid {
          display: grid;
          grid-template-columns: repeat(5, minmax(0, 1fr));
          gap: 32px;
          position: relative;
          z-index: 1;
        }

        #{{ sid }} .lco-step {
          text-align: center;
        }

    #{{ sid }} .lco-step__icon {
      width: 112px;
      height: 112px;
      margin: 0 auto 24px;
      background: var(--surface);
      border: 1px solid var(--line-strong);
      display: flex;
      align-items: center;
      justify-content: center;
    }

       #{{ sid }} .lco-step__icon .material-symbols-outlined {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 44px;
      line-height: 1;
      color: var(--primary);
    }

        #{{ sid }} .lco-step h4 {
          font-size: 14px !important;
          font-weight: 700 !important;
          text-transform: uppercase;
          letter-spacing: 0.22em;
          color: var(--ink) !important;
          margin-bottom: 14px !important;
        }

        #{{ sid }} .lco-step p {
          color: var(--text-muted);
          font-size: 14px;
          line-height: 1.75;
          max-width: 220px;
          margin: 0 auto;
        }

        #{{ sid }} .lco-archive-head {
          margin-bottom: 24px;
        }

        #{{ sid }} .lco-archive-head p {
          margin-top: 16px !important;
          max-width: 760px;
          color: var(--text-muted);
          line-height: 1.8;
        }

        #{{ sid }} .lco-columns {
          column-count: 3;
          column-gap: 24px;
        }

        #{{ sid }} .lco-archive-card {
          position: relative;
          overflow: hidden;
          break-inside: avoid;
          margin-bottom: 24px;
          background: var(--surface);
        }

        #{{ sid }} .lco-archive-card img {
          width: 100%;
        }

        #{{ sid }} .lco-archive-overlay {
          position: absolute;
          inset: 0;
          background: rgba(31, 27, 24, 0.65);
          opacity: 0;
          transition: opacity 0.25s ease;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 32px;
        }

        #{{ sid }} .lco-archive-card:hover .lco-archive-overlay {
          opacity: 1;
        }

        #{{ sid }} .lco-archive-overlay p {
          color: #fff;
          text-align: center;
          font-size: 12px;
          font-weight: 700;
          letter-spacing: 0.22em;
          text-transform: uppercase;
        }

        #{{ sid }} .lco-story {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 48px 80px;
          align-items: center;
        }

        #{{ sid }} .lco-story__figure {
          height: 600px;
          overflow: hidden;
          background: var(--surface);
        }

        #{{ sid }} .lco-story__figure img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        #{{ sid }} .lco-story__copy {
          text-align: left;
        }

        #{{ sid }} .lco-story__copy .lco-soft-rule {
          max-width: 128px;
          margin: 0 0 32px;
        }

        #{{ sid }} .lco-story__copy p + p {
          margin-top: 24px !important;
        }

        #{{ sid }} .lco-story__copy p {
          color: var(--text-muted);
          line-height: 1.8;
          font-size: 16px;
        }

        #{{ sid }} .lco-faq-wrap {
          max-width: 960px;
          margin: 0 auto;
        }

        #{{ sid }} details > summary {
          list-style: none;
        }

        #{{ sid }} details > summary::-webkit-details-marker {
          display: none;
        }

        #{{ sid }} .lco-faq-item {
          background: var(--surface);
          padding: 22px 24px;
        }

        #{{ sid }} .lco-faq-item + .lco-faq-item {
          margin-top: 16px;
        }

        #{{ sid }} .lco-faq-summary {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 16px;
          cursor: pointer;
          font-size: 13px !important;
          font-weight: 700 !important;
          color: var(--ink) !important;
          text-transform: uppercase;
          letter-spacing: 0.08em;
        }

       #{{ sid }} .lco-faq-icon {
        color: var(--primary);
        transition: transform 0.25s ease;
        flex-shrink: 0;
        font-size: 28px;
      }

        #{{ sid }} details[open] .lco-faq-icon {
          transform: rotate(180deg);
        }

        #{{ sid }} .lco-faq-answer {
          margin-top: 16px !important;
          color: var(--text-muted);
          line-height: 1.8;
          font-size: 16px;
        }

        #{{ sid }} .lco-cta {
          background: var(--primary-deep);
          color: #fff;
          text-align: center;
          padding: 88px 0;
        }

        #{{ sid }} .lco-cta__text {
          max-width: 760px;
          margin: 0 auto 40px !important;
          color: rgba(255,255,255,0.82);
          line-height: 1.8;
          font-size: 18px;
        }

        #{{ sid }} .lco-btn--light {
          background: var(--surface);
          color: var(--primary-deep) !important;
        }

        #{{ sid }} .lco-btn--light:hover {
          background: var(--surface-high);
        }

        #{{ sid }} .lco-btn--outline-light {
          border: 1px solid rgba(255,255,255,0.3);
          color: #fff !important;
          background: transparent;
          gap: 12px;
        }

        #{{ sid }} .lco-btn--outline-light:hover {
          background: rgba(255,255,255,0.1);
        }

        @media (min-width: 1024px) {
          #{{ sid }} .lco-process-line::before {
            display: block;
          }
        }

        @media (max-width: 1199px) {
          #{{ sid }} .lco-range-grid,
          #{{ sid }} .lco-process-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          #{{ sid }} .lco-grid-6 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          #{{ sid }} .lco-story {
            grid-template-columns: 1fr;
            gap: 48px;
          }
        }

        @media (max-width: 767px) {
          #{{ sid }} .lco-wrap,
          #{{ sid }} .lco-hero__content {
            width: min(100% - 24px, 1280px);
          }

          #{{ sid }} .lco-section,
          #{{ sid }} .lco-cta {
            padding: 72px 0;
          }

          #{{ sid }} .lco-hero {
            min-height: 92vh;
          }

          #{{ sid }} .lco-hero__content {
            padding-top: 110px;
            padding-bottom: 110px;
          }

          #{{ sid }} .lco-btn-row {
            flex-direction: column;
          }

          #{{ sid }} .lco-btn {
            width: 100%;
          }

          #{{ sid }} .lco-grid-6,
          #{{ sid }} .lco-range-grid,
          #{{ sid }} .lco-process-grid {
            grid-template-columns: 1fr;
          }

          #{{ sid }} .lco-columns {
            column-count: 1;
          }

          #{{ sid }} .lco-story__figure {
            height: 340px;
          }

          #{{ sid }} .lco-story__copy {
            text-align: center;
          }

          #{{ sid }} .lco-story__copy .lco-soft-rule {
            margin: 0 auto 32px;
          }
        }
</style>

<section id="{{ sid }}">
  <header class="lco-hero">
    <div class="lco-hero__media">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 2400 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          loading="eager"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
        >
      {% else %}
        <img
          src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Custom_Orders_BANNER.jpg?v=1775557397"
          alt="Close-up of artisan hands meticulously hand-stitching a piece of dark brown leather using waxed thread in a warm workshop environment"
          loading="eager"
        >
      {% endif %}
    </div>

    <div class="lco-hero__overlay"></div>
    <div class="lco-hero__gradient"></div>

    <div class="lco-hero__content">
      <div class="lco-hero__inner">
        <div class="lco-hero__badge">{{ section.settings.hero_badge }}</div>

        <h1 class="lco-display lco-title lco-hero__title">
          {{ section.settings.hero_title }}
        </h1>

        <div class="lco-soft-rule lco-hero__rule"></div>

        <p class="lco-hero__text">{{ section.settings.hero_text }}</p>

        <div class="lco-btn-row">
          <a href="{{ section.settings.hero_primary_url }}" class="lco-btn lco-btn--primary lco-industrial-button">
            {{ section.settings.hero_primary_label }}
          </a>

          <a href="#{{ sid }}-archive" class="lco-btn lco-btn--ghost">
            {{ section.settings.hero_secondary_label }}
          </a>
        </div>
      </div>
    </div>

    <div class="lco-trustbar">
      <div class="lco-wrap">
        <div class="lco-trustbar__inner">
          <span>Single Piece Orders</span>
          <span>Worldwide Delivery</span>
          <span>100% Handcrafted</span>
          <span>Your Design</span>
        </div>
      </div>
    </div>
  </header>

  <section class="lco-section lco-artisan-panel lco-divider">
    <div class="lco-wrap">
      <div style="margin-bottom:48px;">
        <span class="lco-eyebrow" style="color:var(--primary-deep); margin-bottom:16px;">
          {{- section.settings.customize_eyebrow -}}
        </span>
        <h2 class="lco-display lco-subtitle" style="color:var(--ink);">{{ section.settings.customize_title }}</h2>
      </div>

      <div class="lco-soft-rule" style="margin-bottom:40px;"></div>

      <div class="lco-grid-6">
        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">workspace_premium</span>
          <h3 class="lco-display">Leather Type</h3>
          <p>
            Choose your preferred finishes from curated full-grain, pebbled, and rustic selections shaped for bespoke
            leather items.
          </p>
        </div>

        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">palette</span>
          <h3 class="lco-display">Color</h3>
          <p>
            Explore dark classics, warm neutrals, and contemporary tones tailored to personal style or brand identity.
          </p>
        </div>

        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">gesture</span>
          <h3 class="lco-display">Stitching Style</h3>
          <p>
            Select stitching details that add structure, personality, and the unmistakable artisan edge of a handmade
            piece.
          </p>
        </div>

        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">construction</span>
          <h3 class="lco-display">Hardware</h3>
          <p>
            Choose refined metal finishes and functional details that support both appearance and long-term performance.
          </p>
        </div>

        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">straighten</span>
          <h3 class="lco-display">Size &amp; Shape</h3>
          <p>Every piece is made to your specifications so the proportions, carry, and function feel intentional.</p>
        </div>

        <div class="lco-card lco-custom-card">
          <span class="material-symbols-outlined">edit_square</span>
          <h3 class="lco-display">Personalization</h3>
          <p>
            Add initials, names, or brand marks through embossing and engraving designed to feel integrated, not added
            on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="lco-section lco-dark lco-divider">
    <div class="lco-wrap">
      <div class="lco-dark-head">
        <span class="lco-eyebrow" style="color:var(--primary-soft); margin-bottom:16px;">
          {{- section.settings.range_eyebrow -}}
        </span>
        <h2 class="lco-display lco-subtitle" style="color:#fff;">{{ section.settings.range_title }}</h2>
        <p>{{ section.settings.range_text }}</p>
      </div>

      <div class="lco-soft-rule" style="margin-bottom:48px;"></div>

      <div class="lco-range-grid">
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">apparel</span></div>
          <span>Jackets</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">shopping_bag</span></div>
          <span>Bags</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">wallet</span></div>
          <span>Wallets</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">horizontal_rule</span></div>
          <span>Belts</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">laptop_mac</span></div>
          <span>Laptop Sleeves</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">card_giftcard</span></div>
          <span>Corporate Gifts</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">steps</span></div>
          <span>Shoes</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">flight</span></div>
          <span>Travel Accs</span>
        </div>
        <div class="lco-range-item">
          <div class="lco-range-icon"><span class="material-symbols-outlined">book</span></div>
          <span>Journals</span>
        </div>
        <div class="lco-range-item is-active">
          <div class="lco-range-icon"><span class="material-symbols-outlined">auto_awesome</span></div>
          <span>Anything You Imagine</span>
        </div>
      </div>
    </div>
  </section>

  <section class="lco-section" style="background:var(--surface-soft);">
    <div class="lco-wrap">
      <div class="lco-process-head">
        <span class="lco-eyebrow" style="color:var(--primary-deep); margin-bottom:16px;">
          {{- section.settings.process_eyebrow -}}
        </span>
        <h2 class="lco-display lco-subtitle" style="color:var(--ink);">{{ section.settings.process_title }}</h2>
      </div>

      <div class="lco-process-line">
        <div class="lco-process-grid">
          <div class="lco-step">
            <div class="lco-step__icon"><span class="material-symbols-outlined">lightbulb</span></div>
            <h4>1. Share Your Idea</h4>
            <p>Send your concept, sketch, or a simple written brief so the direction is clear from the start.</p>
          </div>

          <div class="lco-step">
            <div class="lco-step__icon"><span class="material-symbols-outlined">draw</span></div>
            <h4>2. Mockup &amp; Approval</h4>
            <p>Review the concept and quote, then approve the direction before production begins.</p>
          </div>

          <div class="lco-step">
            <div class="lco-step__icon"><span class="material-symbols-outlined">layers</span></div>
            <h4>3. Material Selection</h4>
            <p>Finalize leather, hardware, colors, and finishing details that define the finished product.</p>
          </div>

          <div class="lco-step">
            <div class="lco-step__icon"><span class="material-symbols-outlined">handyman</span></div>
            <h4>4. Handcrafting</h4>
            <p>Our artisans shape, stitch, and finish the piece with careful workshop precision.</p>
          </div>

          <div class="lco-step">
            <div class="lco-step__icon"><span class="material-symbols-outlined">verified_user</span></div>
            <h4>5. Delivery</h4>
            <p>Your order is checked, packed securely, and shipped worldwide to arrive ready for use.</p>
          </div>
        </div>
      </div>

      <div style="margin-top:56px; text-align:center;">
        <a href="{{ section.settings.hero_primary_url }}" class="lco-btn lco-btn--primary lco-industrial-button">
          {{ section.settings.process_button_label }}
        </a>
      </div>
    </div>
  </section>

  <section id="{{ sid }}-archive" class="lco-section lco-divider">
    <div class="lco-wrap">
      <div class="lco-archive-head">
        <span class="lco-eyebrow" style="color:var(--primary-deep); margin-bottom:16px;">
          {{- section.settings.archive_eyebrow -}}
        </span>
        <h2 class="lco-display lco-subtitle" style="color:var(--ink);">{{ section.settings.archive_title }}</h2>
        <p>{{ section.settings.archive_text }}</p>
      </div>

      <div class="lco-soft-rule" style="margin-bottom:40px;"></div>

      <div class="lco-columns">
        <div class="lco-card lco-archive-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Archieve-_executive_brief_case.jpg?v=1775557712"
            alt="Detailed macro shot of a custom leather briefcase handle with precise hand-stitched details and polished antique brass rivets"
            loading="lazy"
          >
          <div class="lco-archive-overlay"><p>Custom Executive Briefcase</p></div>
        </div>

        <div class="lco-card lco-archive-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Archieve-_The_Blue_print_stage.jpg?v=1775557799"
            alt="Artisan sketch of a messenger bag design resting on a piece of raw vegetable-tanned leather with professional marking tools nearby"
            loading="lazy"
          >
          <div class="lco-archive-overlay"><p>The Blueprint Stage</p></div>
        </div>

        <div class="lco-card lco-archive-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Archieve-_Material_sourcing_1.jpg?v=1775557880"
            alt="Interior workshop view showing an array of leather hides in various rich brown and tan tones hanging from industrial racks"
            loading="lazy"
          >
          <div class="lco-archive-overlay"><p>Material Sourcing</p></div>
        </div>

        <div class="lco-card lco-archive-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Archeive_-_Tradional_Punching.jpg?v=1775557935"
            alt="Extreme close up of hand-punching holes in heavy leather using a traditional prong chisel and wooden mallet"
            loading="lazy"
          >
          <div class="lco-archive-overlay"><p>Traditional Punching</p></div>
        </div>

        <div class="lco-card lco-archive-card">
          <img
            src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Archive-_monogram_tech_sleeve1.jpg?v=1775557956"
            alt="Finished custom leather laptop sleeve in a deep mahogany finish with personalized initials embossed on the front corner"
            loading="lazy"
          >
          <div class="lco-archive-overlay"><p>Monogrammed Tech Sleeve</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="lco-section lco-divider" style="background:var(--surface-high);">
    <div class="lco-wrap">
      <div class="lco-story">
        <div class="lco-card lco-story__figure">
          {% if section.settings.story_image != blank %}
            <img
              src="{{ section.settings.story_image | image_url: width: 1600 }}"
              alt="{{ section.settings.story_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.story_image.width }}"
              height="{{ section.settings.story_image.height }}"
            >
          {% else %}
            <img
              src="https://cdn.shopify.com/s/files/1/0753/4054/6238/files/Heritage-_Mastering_the_art_of_one.jpg?v=1775558039"
              alt="Sun-drenched traditional leather workshop with wooden benches, copper tools, and an artisan quietly working in the background"
              loading="lazy"
            >
          {% endif %}
        </div>

        <div class="lco-story__copy">
          <span class="lco-eyebrow" style="color:var(--primary-deep); margin-bottom:16px;">
            {{- section.settings.story_eyebrow -}}
          </span>
          <h2 class="lco-display lco-subtitle" style="color:var(--ink); margin-bottom:32px !important;">
            {{ section.settings.story_title }}
          </h2>
          <div class="lco-soft-rule"></div>
          <p>{{ section.settings.story_p1 }}</p>
          <p>{{ section.settings.story_p2 }}</p>
          <p>{{ section.settings.story_p3 }}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="lco-section lco-divider" style="background:var(--surface-soft);">
    <div class="lco-wrap lco-faq-wrap">
      <div style="text-align:center; margin-bottom:48px;">
        <span class="lco-eyebrow" style="color:var(--primary-deep); margin-bottom:16px;">
          {{- section.settings.faq_eyebrow -}}
        </span>
        <h2 class="lco-display lco-subtitle" style="color:var(--ink);">{{ section.settings.faq_title }}</h2>
      </div>

      <details class="lco-card lco-faq-item">
        <summary class="lco-faq-summary">
          {{ section.settings.faq_q1 }}
          <span class="material-symbols-outlined lco-faq-icon">expand_more</span>
        </summary>
        <p class="lco-faq-answer">{{ section.settings.faq_a1 }}</p>
      </details>

      <details class="lco-card lco-faq-item">
        <summary class="lco-faq-summary">
          {{ section.settings.faq_q2 }}
          <span class="material-symbols-outlined lco-faq-icon">expand_more</span>
        </summary>
        <p class="lco-faq-answer">{{ section.settings.faq_a2 }}</p>
      </details>

      <details class="lco-card lco-faq-item">
        <summary class="lco-faq-summary">
          {{ section.settings.faq_q3 }}
          <span class="material-symbols-outlined lco-faq-icon">expand_more</span>
        </summary>
        <p class="lco-faq-answer">{{ section.settings.faq_a3 }}</p>
      </details>

      <details class="lco-card lco-faq-item">
        <summary class="lco-faq-summary">
          {{ section.settings.faq_q4 }}
          <span class="material-symbols-outlined lco-faq-icon">expand_more</span>
        </summary>
        <p class="lco-faq-answer">{{ section.settings.faq_a4 }}</p>
      </details>

      <details class="lco-card lco-faq-item">
        <summary class="lco-faq-summary">
          {{ section.settings.faq_q5 }}
          <span class="material-symbols-outlined lco-faq-icon">expand_more</span>
        </summary>
        <p class="lco-faq-answer">{{ section.settings.faq_a5 }}</p>
      </details>
    </div>
  </section>

  <section class="lco-cta lco-divider">
    <div class="lco-wrap" style="max-width:960px; text-align:center;">
      <span class="lco-eyebrow" style="color:var(--primary-soft); margin-bottom:16px;">
        {{- section.settings.cta_eyebrow -}}
      </span>
      <h2 class="lco-display lco-subtitle" style="color:#fff; margin-bottom:28px !important;">
        {{ section.settings.cta_title }}
      </h2>
      <p class="lco-cta__text">{{ section.settings.cta_text }}</p>

      <div class="lco-btn-row">
        <a href="{{ section.settings.cta_primary_url }}" class="lco-btn lco-btn--light lco-industrial-button">
          {{ section.settings.cta_primary_label }}
        </a>

        {% if section.settings.cta_secondary_url != blank %}
          <a href="{{ section.settings.cta_secondary_url }}" class="lco-btn lco-btn--outline-light">
            <span class="material-symbols-outlined">chat</span>
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </section>
</section>

{% schema %}
{
  "name": "Custom order",
  "tag": "section",
  "class": "section section-leathery-custom-order",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_badge",
      "label": "Hero badge",
      "default": "Factory Direct • Artisan Finished"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title",
      "default": "Custom Leather Products Personalized For You And Your Business"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "From initials to brand logos, your vision meets our craftsmen. Design custom made leather goods with precision, character, and a true artisan edge."
    },
    {
      "type": "text",
      "id": "hero_primary_label",
      "label": "Hero primary button label",
      "default": "Submit Your Custom Order"
    },
    {
      "type": "url",
      "id": "hero_primary_url",
      "label": "Hero primary button URL"
    },
    {
      "type": "text",
      "id": "hero_secondary_label",
      "label": "Hero secondary button label",
      "default": "View Craft Archive"
    },
    {
      "type": "text",
      "id": "customize_eyebrow",
      "label": "Customize eyebrow",
      "default": "Bespoke Excellence"
    },
    {
      "type": "text",
      "id": "customize_title",
      "label": "Customize title",
      "default": "What You Can Customize"
    },
    {
      "type": "text",
      "id": "range_eyebrow",
      "label": "Range eyebrow",
      "default": "Product Range"
    },
    {
      "type": "text",
      "id": "range_title",
      "label": "Range title",
      "default": "Creative Craftsmanship"
    },
    {
      "type": "textarea",
      "id": "range_text",
      "label": "Range text",
      "default": "From everyday essentials to statement pieces, we create leather products that hold industrial precision and boutique character in the same hand."
    },
    {
      "type": "text",
      "id": "process_eyebrow",
      "label": "Process eyebrow",
      "default": "Order Process"
    },
    {
      "type": "text",
      "id": "process_title",
      "label": "Process title",
      "default": "The Custom Journey"
    },
    {
      "type": "text",
      "id": "process_button_label",
      "label": "Process button label",
      "default": "Submit Your Custom Order"
    },
    {
      "type": "text",
      "id": "archive_eyebrow",
      "label": "Archive eyebrow",
      "default": "Past Work"
    },
    {
      "type": "text",
      "id": "archive_title",
      "label": "Archive title",
      "default": "The Archive"
    },
    {
      "type": "textarea",
      "id": "archive_text",
      "label": "Archive text",
      "default": "A glimpse into previous work. Refined wallets, workshop process moments, and handcrafted pieces built with precision and intention."
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story eyebrow",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story title",
      "default": "Mastering The Art Of One"
    },
    {
      "type": "textarea",
      "id": "story_p1",
      "label": "Story paragraph 1",
      "default": "At Leathery.pro, each piece starts with purpose. The best leather products are not mass-produced. They are shaped with intent for a specific use and a specific person."
    },
    {
      "type": "textarea",
      "id": "story_p2",
      "label": "Story paragraph 2",
      "default": "Our workshop is rooted in craftsmanship, where artisans build custom leather products through traditional methods and careful handwork. Every order is treated as its own creation."
    },
    {
      "type": "textarea",
      "id": "story_p3",
      "label": "Story paragraph 3",
      "default": "We focus on quality that carries through daily use and ages with character. From the first idea to the final stitch, each order is prepared with care, discipline, and material respect."
    },
    {
      "type": "text",
      "id": "faq_eyebrow",
      "label": "FAQ eyebrow",
      "default": "Common Questions"
    },
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ title",
      "default": "Frequently Asked"
    },
    {
      "type": "text",
      "id": "faq_q1",
      "label": "FAQ question 1",
      "default": "How long does an average custom piece take?"
    },
    {
      "type": "textarea",
      "id": "faq_a1",
      "label": "FAQ answer 1",
      "default": "Lead time depends on complexity, materials, and finishing requirements, though most custom orders move forward within a reasonable production window after approval."
    },
    {
      "type": "text",
      "id": "faq_q2",
      "label": "FAQ question 2",
      "default": "Do you ship to my country?"
    },
    {
      "type": "textarea",
      "id": "faq_a2",
      "label": "FAQ answer 2",
      "default": "Yes. We support worldwide delivery for custom leather orders."
    },
    {
      "type": "text",
      "id": "faq_q3",
      "label": "FAQ question 3",
      "default": "Is it possible to order only one piece?"
    },
    {
      "type": "textarea",
      "id": "faq_a3",
      "label": "FAQ answer 3",
      "default": "Yes. We accept both single-piece orders and small batch requests."
    },
    {
      "type": "text",
      "id": "faq_q4",
      "label": "FAQ question 4",
      "default": "What type of leather do you use?"
    },
    {
      "type": "textarea",
      "id": "faq_a4",
      "label": "FAQ answer 4",
      "default": "We work with carefully selected materials chosen for finish, durability, and suitability for the product being developed."
    },
    {
      "type": "text",
      "id": "faq_q5",
      "label": "FAQ question 5",
      "default": "Can you work from a rough sketch?"
    },
    {
      "type": "textarea",
      "id": "faq_a5",
      "label": "FAQ answer 5",
      "default": "Absolutely. A rough sketch, reference image, or short written idea is enough to begin the design conversation."
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "CTA eyebrow",
      "default": "Start Your Order"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Ready To Create Something Unique?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Step away from ordinary products and build something designed around your use, your brand, or your personal idea. We shape it with care, clarity, and workshop discipline."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "CTA primary button label",
      "default": "Submit Custom Order Inquiry"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "CTA primary button URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "CTA secondary button label",
      "default": "Chat With A Designer"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "CTA secondary button URL"
    }
  ],
  "presets": [
    {
      "name": "Custom order"
    }
  ]
}
{% endschema %}
